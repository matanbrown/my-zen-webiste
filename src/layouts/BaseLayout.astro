---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: "he" | "en";
}
const { title, description, lang = "he" } = Astro.props;
const isEn = lang === "en";

const SITE_NAME = isEn ? "Without Effort" : "ללא מאמץ";

const pageTitle = title === SITE_NAME ? SITE_NAME : `${title} — ${SITE_NAME}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// Equivalent URL in the other language — routes mirror 1:1 by slug, so this
// is just adding/stripping the "/en" prefix.
const otherLangPath = isEn
  ? Astro.url.pathname.replace(/^\/en\/?/, "/")
  : `/en${Astro.url.pathname}`;
const otherLangUrl = new URL(otherLangPath, Astro.site);

const NAV: [string, string][] = isEn
  ? [
      ["/en/lessons/", "Lessons"],
      ["/en/practices/", "Practices"],
      ["/en/inspirations/", "Inspirations"],
      ["/en/poems/", "Poems"],
      ["/en/retreats/", "Retreats"],
      ["/en/about/", "About"],
      ["/en/contact/", "Contact"],
    ]
  : [
      ["/lessons/", "שיעורים"],
      ["/practices/", "תרגולים"],
      ["/inspirations/", "השראה"],
      ["/poems/", "שירה"],
      ["/retreats/", "ריטריטים"],
      ["/about/", "אודות"],
      ["/contact/", "צור קשר"],
    ];
---

<!doctype html>
<html lang={lang} dir={isEn ? "ltr" : "rtl"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="he" href={isEn ? otherLangUrl : canonicalUrl} />
    <link rel="alternate" hreflang="en" href={isEn ? canonicalUrl : otherLangUrl} />
    <link rel="alternate" hreflang="x-default" href={isEn ? otherLangUrl : canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content={isEn ? "en_US" : "he_IL"} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {import.meta.env.PROD && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-EQ4Q50PXZF"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(...args) { window.dataLayer.push(args); }
          gtag("js", new Date());
          gtag("config", "G-EQ4Q50PXZF");
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{isEn ? "Skip to content" : "דלג לתוכן הדף"}</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={isEn ? "/en/" : "/"}>
          <span class="brand-mark">禅</span>
          <span>{SITE_NAME}</span>
        </a>
        <nav aria-label={isEn ? "Main navigation" : "ניווט ראשי"}>
          {NAV.map(([href, label]) => <a href={href}>{label}</a>)}
          <a href={otherLangUrl.pathname} class="lang-switch" hreflang={isEn ? "he" : "en"}>
            {isEn ? "עברית" : "English"}
          </a>
        </nav>
      </header>
      <main id="main" class="content">
        <slot />
      </main>
      <footer class="site-footer">
        <hr class="rule" />
        <p class="eyebrow">zen.matanbrown.com</p>
      </footer>
    </div>

    <style>
      .shell { max-width: 720px; margin: 0 auto; padding: var(--space-3); }
      .site-header {
        display: flex; justify-content: space-between; align-items: baseline;
        flex-wrap: wrap; gap: var(--space-2);
        padding-block: var(--space-3) var(--space-4);
      }
      .brand { display: inline-flex; align-items: baseline; gap: var(--space-1);
        text-decoration: none; color: var(--ink); font-family: var(--font-display); font-size: 1.15rem; }
      .brand-mark { color: var(--seal); font-size: 1.5rem; }
      nav a { margin-inline-start: var(--space-2); font-size: .92rem; text-decoration: none; color: var(--ink-soft); }
      nav a:hover { color: var(--indigo); }
      .lang-switch { border-inline-start: 1px solid var(--stone-line); padding-inline-start: var(--space-2); }
      .site-footer { margin-top: var(--space-5); }
    </style>
  </body>
</html>
