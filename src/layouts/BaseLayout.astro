---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title: string;
  description?: string;
  lang?: "he" | "en";
  /** Extra JSON-LD object(s) for this specific page (e.g. Article schema for a lesson). Merged alongside the sitewide WebSite schema. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Root-relative path to a page-specific OG/Twitter image (e.g. a lesson's coverImage). Defaults to the sitewide /og-image.png. */
  image?: string;
}
const { title, description, lang = "he", jsonLd, image = "/og-image.png" } = Astro.props;
const ogImageUrl = new URL(image, Astro.site);
const isEn = lang === "en";

const SITE_NAME = isEn ? "Without Effort" : "ללא מאמץ";

const pageTitle = title === SITE_NAME ? SITE_NAME : `${title} — ${SITE_NAME}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// Equivalent URL in the other language — routes mirror 1:1 by slug, so this
// is just adding/stripping the "/en" prefix.
const otherLangPath = isEn
  ? Astro.url.pathname.replace(/^\/en\/?/, "/")
  : `/en${Astro.url.pathname}`;
const otherLangUrl = new URL(otherLangPath, Astro.site);

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: String(Astro.site),
  inLanguage: isEn ? "en-US" : "he-IL",
  description: isEn
    ? "A personal Zen practice site: weekly lessons, meditation practices, poems, and retreat stories."
    : "אתר תרגול זן אישי: שיעורים שבועיים, תרגולי מדיטציה, שירה וסיפורי ריטריט.",
};

const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allJsonLd = [websiteJsonLd, ...pageJsonLd];

const NAV: [string, string][] = isEn
  ? [
      ["/en/start-here/", "Start Here"],
      ["/en/lessons/", "Lessons"],
      ["/en/practices/", "Practices"],
      ["/en/inspirations/", "Inspirations"],
      ["/en/retreats/", "Retreats"],
      ["/en/about/", "About"],
      ["/en/contact/", "Contact"],
    ]
  : [
      ["/start-here/", "התחילו כאן"],
      ["/lessons/", "שיעורים"],
      ["/practices/", "תרגולים"],
      ["/inspirations/", "השראה"],
      ["/retreats/", "ריטריטים"],
      ["/about/", "אודות"],
      ["/contact/", "צור קשר"],
    ];
---

<!doctype html>
<html lang={lang} dir={isEn ? "ltr" : "rtl"}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Runs before first paint to avoid a flash of the wrong theme.
      // Priority: saved choice > system preference > light (default).
      (function () {
        var saved = localStorage.getItem("theme");
        var theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        if (theme === "dark") document.documentElement.setAttribute("data-theme", "dark");
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="he" href={isEn ? otherLangUrl : canonicalUrl} />
    <link rel="alternate" hreflang="en" href={isEn ? canonicalUrl : otherLangUrl} />
    <link rel="alternate" hreflang="x-default" href={isEn ? otherLangUrl : canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ede9e1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e1c19" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+Hebrew:wght@400;500;600;700&family=Noto+Sans+Hebrew:wght@400;500;600&display=swap"
    />

    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — ${isEn ? "Lessons" : "שיעורים"}`} href={isEn ? "/en/rss.xml" : "/rss.xml"} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content={isEn ? "en_US" : "he_IL"} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    {allJsonLd.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
    {import.meta.env.PROD && (
      <script is:inline>
        // GA is NOT loaded here — only a loader function is defined. It's
        // only invoked once the person accepts the cookie banner (see
        // CookieConsent.astro), or automatically on repeat visits once
        // consent was already given (checked below). No analytics
        // cookies are set before explicit consent.
        window.__loadGA = function () {
          if (window.__gaLoaded) return;
          window.__gaLoaded = true;
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          window.gtag = gtag;
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=G-EQ4Q50PXZF";
          document.head.appendChild(s);
          gtag("js", new Date());
          gtag("config", "G-EQ4Q50PXZF");
        };
        if (localStorage.getItem("cookie_consent") === "accepted") {
          window.__loadGA();
        }
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{isEn ? "Skip to content" : "דלג לתוכן הדף"}</a>
    <CookieConsent lang={lang} />
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={isEn ? "/en/" : "/"}>
          <span class="brand-mark">禅</span>
          <span>{SITE_NAME}</span>
        </a>
        <nav aria-label={isEn ? "Main navigation" : "ניווט ראשי"} id="site-nav">
          {NAV.map(([href, label]) => <a href={href}>{label}</a>)}
          <a href={otherLangUrl.pathname} class="lang-switch" hreflang={isEn ? "he" : "en"}>
            {isEn ? "עברית" : "English"}
          </a>
        </nav>
        <div class="header-actions">
          <div class="search">
            <button
              id="search-toggle"
              class="search-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="search-panel"
            >
              <span class="sr-only">{isEn ? "Search" : "חיפוש"}</span>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </button>
            <div id="search-panel" class="search-panel" hidden>
              <input
                id="search-input"
                type="search"
                placeholder={isEn ? "Search…" : "חיפוש…"}
                autocomplete="off"
              />
              <ul id="search-results" class="search-results"></ul>
              <p id="search-empty" class="search-empty eyebrow" hidden>{isEn ? "No results" : "אין תוצאות"}</p>
            </div>
          </div>
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-pressed="false"
          >
            <span class="sr-only">{isEn ? "Toggle dark mode" : "החלפת מצב תאורה"}</span>
            <svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
            </svg>
          </button>
          <button
            id="nav-toggle"
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav"
          >
            <span class="sr-only">{isEn ? "Menu" : "תפריט"}</span>
            <span class="nav-toggle-bars" aria-hidden="true"></span>
          </button>
        </div>
      </header>
      <main id="main" class="content" data-pagefind-body>
        <slot />
      </main>
      <footer class="site-footer">
        <hr class="rule" />
        <p class="eyebrow">
          zen.matanbrown.com
          {" · "}
          <a href={isEn ? "/en/colophon/" : "/colophon/"}>{isEn ? "How this site is built" : "איך האתר בנוי"}</a>
          {" · "}
          <a href={isEn ? "/en/privacy/" : "/privacy/"}>{isEn ? "Privacy" : "פרטיות"}</a>
        </p>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var toggle = document.getElementById("nav-toggle");
        var nav = document.getElementById("site-nav");
        if (!toggle || !nav) return;
        toggle.addEventListener("click", function () {
          var isOpen = nav.classList.toggle("is-open");
          toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
        });
        nav.addEventListener("click", function (e) {
          if (e.target.tagName === "A") {
            nav.classList.remove("is-open");
            toggle.setAttribute("aria-expanded", "false");
          }
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && nav.classList.contains("is-open")) {
            nav.classList.remove("is-open");
            toggle.setAttribute("aria-expanded", "false");
            toggle.focus();
          }
        });
      })();
    </script>

    <script is:inline>
      (function () {
        var toggle = document.getElementById("theme-toggle");
        if (!toggle) return;
        function currentTheme() {
          return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
        }
        toggle.setAttribute("aria-pressed", currentTheme() === "dark" ? "true" : "false");
        toggle.addEventListener("click", function () {
          var next = currentTheme() === "dark" ? "light" : "dark";
          if (next === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
          } else {
            document.documentElement.removeAttribute("data-theme");
          }
          localStorage.setItem("theme", next);
          toggle.setAttribute("aria-pressed", next === "dark" ? "true" : "false");
        });
      })();
    </script>

    <script is:inline>
      (function () {
        var toggle = document.getElementById("search-toggle");
        var panel = document.getElementById("search-panel");
        var input = document.getElementById("search-input");
        var results = document.getElementById("search-results");
        var empty = document.getElementById("search-empty");
        if (!toggle || !panel || !input) return;

        var pagefindPromise = null;
        function getPagefind() {
          if (!pagefindPromise) {
            pagefindPromise = import("/pagefind/pagefind.js")
              .then(function (mod) {
                return mod.init().then(function () { return mod; });
              })
              .catch(function (err) {
                console.warn("Search index not available (only exists in production builds):", err);
                return null;
              });
          }
          return pagefindPromise;
        }

        function openPanel() {
          panel.hidden = false;
          toggle.setAttribute("aria-expanded", "true");
          input.focus();
          getPagefind();
        }
        function closePanel() {
          panel.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
        }

        toggle.addEventListener("click", function () {
          if (panel.hidden) openPanel();
          else closePanel();
        });

        document.addEventListener("click", function (e) {
          if (!panel.hidden && !panel.contains(e.target) && e.target !== toggle && !toggle.contains(e.target)) {
            closePanel();
          }
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && !panel.hidden) {
            closePanel();
            toggle.focus();
          }
        });

        var debounceTimer;
        input.addEventListener("input", function () {
          clearTimeout(debounceTimer);
          var query = input.value.trim();
          debounceTimer = setTimeout(function () { runSearch(query); }, 150);
        });

        function runSearch(query) {
          results.innerHTML = "";
          empty.hidden = true;
          if (!query) return;

          getPagefind().then(function (pagefind) {
            if (!pagefind) return;
            pagefind.search(query).then(function (search) {
              if (input.value.trim() !== query) return; // stale response
              if (window.gtag) {
                window.gtag("event", "search", {
                  search_term: query,
                  result_count: search.results.length,
                });
              }
              if (search.results.length === 0) {
                empty.hidden = false;
                return;
              }
              Promise.all(search.results.slice(0, 8).map(function (r) { return r.data(); })).then(function (items) {
                results.innerHTML = items
                  .map(function (item) {
                    var excerpt = item.excerpt || "";
                    return (
                      '<li><a href="' + item.url + '">' +
                      '<span class="result-title">' + item.meta.title + "</span>" +
                      '<span class="result-excerpt">' + excerpt + "</span>" +
                      "</a></li>"
                    );
                  })
                  .join("");
              });
            });
          });
        }
      })();
    </script>

    <style>
      .shell { max-width: 720px; margin: 0 auto; padding: var(--space-3); }
      .site-header {
        display: flex; justify-content: space-between; align-items: baseline;
        flex-wrap: wrap; gap: var(--space-2);
        padding-block: var(--space-3) var(--space-4);
      }
      .brand { display: inline-flex; align-items: baseline; gap: var(--space-1);
        text-decoration: none; color: var(--ink); font-family: var(--font-display); font-size: 1.15rem; }
      .brand-mark { color: var(--seal); font-size: 1.5rem; }
      nav a { margin-inline-start: var(--space-2); font-size: .92rem; text-decoration: none; color: var(--ink-soft); }
      nav a:hover { color: var(--indigo); }
      .lang-switch { border-inline-start: 1px solid var(--stone-line); padding-inline-start: var(--space-2); }
      .site-footer { margin-top: var(--space-5); }

      .search { position: relative; }
      .header-actions { display: flex; align-items: center; gap: var(--space-1); }
      .search-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        background: none;
        border: none;
        color: var(--ink-soft);
        cursor: pointer;
      }
      .search-toggle:hover { color: var(--indigo); }
      .search-panel {
        position: absolute;
        inset-inline-end: 0;
        top: calc(100% + var(--space-1));
        width: 20rem;
        max-width: calc(100vw - 2 * var(--space-3));
        background: var(--paper-raised);
        border: 1px solid var(--stone-line);
        border-radius: 6px;
        padding: var(--space-2);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        z-index: 60;
      }
      .search-panel input {
        width: 100%;
        font: inherit;
        padding: 0.5rem 0.7rem;
        border: 1px solid var(--stone-line);
        border-radius: 4px;
        background: var(--paper);
        color: var(--ink);
      }
      .search-panel input:focus-visible {
        outline: 2px solid var(--indigo);
        outline-offset: 1px;
      }
      .search-results {
        list-style: none;
        padding: 0;
        margin: var(--space-1) 0 0;
        max-height: 60vh;
        overflow-y: auto;
      }
      .search-results li + li { border-top: 1px solid var(--stone-line); }
      .search-results a {
        display: block;
        padding: var(--space-1) 0;
        text-decoration: none;
        color: inherit;
      }
      .search-results .result-title {
        display: block;
        font-family: var(--font-display);
        color: var(--ink);
      }
      .search-results a:hover .result-title { color: var(--indigo); }
      .search-results .result-excerpt {
        display: block;
        font-size: 0.82rem;
        color: var(--ink-soft);
        margin-top: 2px;
      }
      .search-results .result-excerpt :global(mark) {
        background: none;
        color: var(--seal);
        font-weight: 600;
      }
      .search-empty { margin: var(--space-2) 0 0; }

      @media (max-width: 640px) {
        .search-panel {
          position: fixed;
          inset-inline: var(--space-2);
          top: 4.5rem;
          width: auto;
          max-width: none;
        }
      }

      .nav-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        background: none;
        border: 1px solid var(--stone-line);
        border-radius: 4px;
        cursor: pointer;
      }
      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        background: none;
        border: none;
        color: var(--ink-soft);
        cursor: pointer;
      }
      .theme-toggle:hover { color: var(--indigo); }
      .theme-toggle .icon-sun { display: none; }
      [data-theme="dark"] .theme-toggle .icon-sun { display: block; }
      [data-theme="dark"] .theme-toggle .icon-moon { display: none; }
      .nav-toggle-bars,
      .nav-toggle-bars::before,
      .nav-toggle-bars::after {
        display: block;
        width: 18px;
        height: 2px;
        background: var(--ink);
      }
      .nav-toggle-bars { position: relative; }
      .nav-toggle-bars::before,
      .nav-toggle-bars::after { content: ""; position: absolute; inset-inline-start: 0; }
      .nav-toggle-bars::before { top: -6px; }
      .nav-toggle-bars::after { top: 6px; }
      .sr-only {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
      }

      @media (max-width: 640px) {
        .site-header { position: relative; }
        .nav-toggle { display: inline-flex; }
        .brand { order: 1; }
        .header-actions { order: 2; }
        nav {
          order: 3;
          display: none;
          flex-direction: column;
          align-items: stretch;
          width: 100%;
          padding-top: var(--space-2);
        }
        nav.is-open { display: flex; }
        nav a {
          margin-inline-start: 0;
          padding: .7rem 0;
          border-top: 1px solid var(--stone-line);
        }
        nav a:first-child { border-top: none; }
        .lang-switch {
          border-inline-start: none;
          padding-inline-start: 0;
          border-top: 1px solid var(--stone-line);
          padding-top: .7rem;
        }
      }
    </style>
  </body>
</html>
