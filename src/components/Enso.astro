---
// A hand-drawn-style ensō: one deliberate brush stroke, not fully closed.
// Appears once, on the homepage hero only — this is the page's signature
// element, so everything else stays quiet around it.
interface Props {
  size?: number;
}
const { size = 220 } = Astro.props;
---

<svg
  class="enso"
  width={size}
  height={size}
  viewBox="0 0 220 220"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    class="enso-stroke"
    d="M 165 60
       C 185 80, 192 108, 184 136
       C 174 168, 144 188, 108 186
       C 74 184, 46 160, 38 128
       C 30 96, 44 62, 74 44
       C 100 28, 132 30, 152 46"
    stroke="var(--ink)"
    stroke-width="7"
    stroke-linecap="round"
  />
</svg>

<style>
  .enso {
    display: block;
  }

  .enso-stroke {
    stroke-dasharray: 620;
    stroke-dashoffset: 620;
    animation: draw 1.8s cubic-bezier(0.65, 0, 0.35, 1) 0.2s forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .enso-stroke {
      stroke-dashoffset: 0;
      animation: none;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
