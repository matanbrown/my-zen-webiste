---
// src/components/ShareButtons.astro
// WhatsApp + copy-link, for the bottom of any content detail page
// (lesson/practice/inspiration/poem/retreat). Uses the current page's
// absolute URL, so no per-page config needed - just drop it in.
interface Props {
  title: string;
  lang?: "he" | "en";
}
const { title, lang = "he" } = Astro.props;
const pageUrl = Astro.url.href;

const label = {
  he: { heading: "שתפו את זה", whatsapp: "וואטסאפ", copy: "העתק קישור", copied: "הקישור הועתק" },
  en: { heading: "Share this", whatsapp: "WhatsApp", copy: "Copy link", copied: "Link copied" },
}[lang];

const waText = encodeURIComponent(`${title} — ${pageUrl}`);
---

<div class="share-buttons" dir={lang === "en" ? "ltr" : "rtl"}>
  <span class="share-buttons__label">{label.heading}</span>
  <a
    class="share-buttons__btn"
    href={`https://wa.me/?text=${waText}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={label.whatsapp}
    title={label.whatsapp}
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.472-.148-.67.15-.198.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" />
      <path d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.462 3.48 1.34 4.997L2 22l5.117-1.342a9.96 9.96 0 0 0 4.887 1.24h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.67-1.04-5.18-2.928-7.069a9.933 9.933 0 0 0-7.073-2.829zm0 18.174h-.003a8.19 8.19 0 0 1-4.174-1.144l-.3-.178-3.037.796.81-2.96-.195-.304a8.164 8.164 0 0 1-1.253-4.386c0-4.512 3.672-8.184 8.187-8.184 2.187 0 4.243.852 5.79 2.401a8.128 8.128 0 0 1 2.396 5.788c0 4.512-3.672 8.171-8.221 8.171z" />
    </svg>
    <span>{label.whatsapp}</span>
  </a>
  <button
    type="button"
    class="share-buttons__btn"
    data-copy-link
    data-url={pageUrl}
    aria-label={label.copy}
    title={label.copy}
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
      <rect x="9" y="9" width="11" height="11" rx="2" />
      <path d="M5 15V5a2 2 0 0 1 2-2h10" />
    </svg>
    <span data-copy-label>{label.copy}</span>
  </button>
</div>

<style>
  .share-buttons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--stone-line);
  }
  .share-buttons__label {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-inline-end: var(--space-1);
  }
  .share-buttons__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--stone-line);
    background: none;
    color: var(--ink-soft);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.85rem;
    font-family: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .share-buttons__btn:hover {
    border-color: var(--indigo);
    color: var(--indigo);
  }
  .share-buttons__btn:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 2px;
  }
</style>

<script>
  const COPIED_TIMEOUT_MS = 2000;

  function initCopyButtons(root: ParentNode) {
    root.querySelectorAll<HTMLButtonElement>("[data-copy-link]").forEach((btn) => {
      if (btn.dataset.copyBound) return;
      btn.dataset.copyBound = "1";
      btn.addEventListener("click", async () => {
        const url = btn.dataset.url!;
        const labelEl = btn.querySelector<HTMLElement>("[data-copy-label]");
        const originalText = labelEl?.textContent ?? "";
        const isEn = document.documentElement.getAttribute("lang") === "en" || document.dir === "ltr";
        try {
          await navigator.clipboard.writeText(url);
        } catch {
          // Fallback for browsers/contexts without Clipboard API access
          const ta = document.createElement("textarea");
          ta.value = url;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          document.body.removeChild(ta);
        }
        if (labelEl) {
          labelEl.textContent = isEn ? "Link copied" : "הקישור הועתק";
          setTimeout(() => {
            labelEl.textContent = originalText;
          }, COPIED_TIMEOUT_MS);
        }
      });
    });
  }

  initCopyButtons(document);
</script>
