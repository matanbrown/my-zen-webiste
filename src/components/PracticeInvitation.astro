---
/**
 * PracticeInvitation.astro
 *
 * Reusable "stop reading, start sitting" component for the end of
 * "Getting Started with Meditation" lessons — built for the lesson
 * "לפני הישיבה הראשונה" (2026-08-05-before-the-first-sitting).
 *
 * Flow: invitation -> 3-minute timer -> reflection
 * - No settings, no configurable duration (fixed 180s) — future versions
 *   may add 5/10 min options, gong sound, wake lock, etc. Not in v1.
 * - "סיימתי" (I'm done) is treated identically to the timer running out —
 *   there is no "failure" path.
 * - On end (natural or via "סיימתי"): plays a short synthesized tone,
 *   vibrates on supporting devices, and reveals the reflection screen.
 *   This is a functional end-signal only (not the future "gong" feature).
 *
 * RESOLVED (2026-08-05, per Matan): this component no longer has its
 * own reflection form/Turnstile widget. Having a second form on the
 * same page as the standard <CommentsSection> caused two separate
 * comment surfaces and a duplicate Turnstile script/widget, which
 * broke submission. Since both would write to the same
 * /api/comments?path=<same path> storage anyway, the reflection step
 * now just prompts with the same questions and points down to the
 * single CommentsSection at the bottom of the page.
 *
 * RESOLVED (2026-08-06, per Matan): English copy added below, translated
 * directly from the Hebrew (same voice/register, first person where the
 * Hebrew is first person) - published straight to /en/ without a separate
 * review step per Matan's instruction.
 */
interface Props {
  lang?: "he" | "en";
}
const { lang = "he" } = Astro.props;
const isEn = lang === "en";

const t = {
  he: {
    invitationHeading: "עכשיו תורכם",
    invitation: [
      "עד עכשיו קראתם.",
      "עכשיו הגיע הזמן להתנסות.",
      "אין צורך בכרית מדיטציה.",
      "אין צורך בתנוחה מיוחדת.",
      "אפשר לשבת על כיסא.",
      "אפשר לשבת על כרית.",
      "אפשר לשבת ברגליים משוכלות או כשהרגליים מונחות על הרצפה.",
      "אין צורך להפסיק לחשוב.",
      "אין צורך להירגע.",
      "אין צורך לנשום בצורה מסוימת.",
      "ואין שום דבר שאתם צריכים להצליח בו.",
      "פשוט עצמו את העיניים.",
      "ושימו לב למה שקורה.",
    ],
    soundHint: "מומלץ לוודא שהסאונד במכשיר פועל, כדי שתשמעו את הצליל בסיום התרגול.",
    startBtn: "▶︎ התחילו תרגול של 3 דקות",
    doneBtn: "סיימתי",
    reflectionHeading: "תודה שבחרתם לעצור לרגע.",
    reflectionIntro: "עכשיו קחו רגע ושאלו את עצמכם:",
    reflectionQuestion: "מה שמתם לב שהיה שם?",
    reflectionBody: [
      "אולי שמתם לב למחשבות.",
      "אולי לחוסר שקט.",
      "אולי לשעמום.",
      "אולי פשוט לזה שהיה לכם קשה לעצור.",
      "ואולי אפילו גיליתם שלא הצלחתם לשבת את כל שלוש הדקות וקמתם באמצע.",
      "גם זאת חוויה שאפשר לשים אליה לב.",
      "אין תשובה נכונה.",
      "יש רק את מה שפגשתם.",
      "בסופו של דבר, אף אחד לא יכול לענות על השאלה הזאת במקומכם.",
      "אם תרצו, קחו רגע לכתוב לעצמכם כמה מילים.",
    ],
    shareBefore: "ואם מתחשק לכם לשתף — אשמח לקרוא, ותוכלו לכתוב כמה מילים",
    shareLink: "בתגובות בתחתית העמוד",
  },
  en: {
    invitationHeading: "Now it's your turn",
    invitation: [
      "Until now, you've been reading.",
      "Now it's time to try it.",
      "You don't need a meditation cushion.",
      "You don't need a special posture.",
      "You can sit on a chair.",
      "You can sit on a cushion.",
      "You can sit cross-legged, or with your feet flat on the floor.",
      "You don't need to stop thinking.",
      "You don't need to relax.",
      "You don't need to breathe in any particular way.",
      "And there's nothing you need to succeed at.",
      "Just close your eyes.",
      "And notice what happens.",
    ],
    soundHint: "It's worth checking your device's sound is on, so you'll hear the tone at the end.",
    startBtn: "▶︎ Start a 3-minute practice",
    doneBtn: "I'm done",
    reflectionHeading: "Thank you for choosing to stop for a moment.",
    reflectionIntro: "Now take a moment and ask yourself:",
    reflectionQuestion: "What did you notice was there?",
    reflectionBody: [
      "Maybe you noticed thoughts.",
      "Maybe restlessness.",
      "Maybe boredom.",
      "Maybe just how hard it was to stop.",
      "Maybe you even found you couldn't sit the full three minutes and got up partway through.",
      "That's a real experience too, worth noticing.",
      "There's no right answer.",
      "There's only what you met.",
      "In the end, no one else can answer this question for you.",
      "If you'd like, take a moment to write yourself a few words.",
    ],
    shareBefore: "And if you feel like sharing — I'd be glad to read it, and you're welcome to write a few words",
    shareLink: "in the comments at the bottom of the page",
  },
}[isEn ? "en" : "he"];
---

<section class="practice-invitation" data-practice-invitation dir={isEn ? "ltr" : "rtl"}>
  <!-- STATE 1: Invitation -->
  <div class="practice-step practice-step--invitation" data-step="invitation">
    <h2>{t.invitationHeading}</h2>
    {t.invitation.map((line) => <p>{line}</p>)}

    <p class="practice-invitation__sound-hint">
      {t.soundHint}
    </p>

    <button type="button" class="practice-btn practice-btn--start" data-action="start">
      {t.startBtn}
    </button>
  </div>

  <!-- STATE 2: Timer -->
  <div class="practice-step practice-step--timer" data-step="timer" hidden>
    <div class="practice-timer__breath" aria-hidden="true"></div>
    <div class="practice-timer__display" data-timer-display>03:00</div>
    <button type="button" class="practice-btn practice-btn--done" data-action="finish">
      {t.doneBtn}
    </button>
  </div>

  <!-- STATE 3: Reflection -->
  <div class="practice-step practice-step--reflection" data-step="reflection" hidden>
    <h2 tabindex="-1" data-reflection-heading>{t.reflectionHeading}</h2>
    <p>{t.reflectionIntro}</p>
    <p><strong>{t.reflectionQuestion}</strong></p>
    {t.reflectionBody.map((line) => <p>{line}</p>)}
    <p>
      {t.shareBefore}{" "}
      <a href="#comments" data-reflection-jump>{t.shareLink}</a>.
    </p>
  </div>
</section>

<style>
  /* Uses the site's real global tokens from src/styles/global.css. */
  .practice-invitation {
    max-width: var(--measure);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--stone-line);
  }

  .practice-invitation p {
    color: var(--ink-soft);
    margin: 0.4rem 0 var(--space-1);
    max-width: var(--measure);
  }

  .practice-invitation h2 {
    margin-top: 0; /* the section's own border-top + padding-top already separate it; the global h2 { margin-top: var(--space-4) } rule was stacking on top of that */
    margin-bottom: var(--space-2);
  }

  /* Timer step alone is centered - it's a standalone widget (breathing
     circle + countdown + button), not running prose, so centering it
     reads intentionally rather than inconsistent with the rest of the site. */
  .practice-step--timer {
    text-align: center;
  }

  /* Focus is moved here programmatically (for screen readers) when the
     timer finishes - :focus-visible (not :focus) means it won't draw a
     box for that, only for real keyboard navigation, matching the
     .practice-btn:focus-visible convention used elsewhere in this file. */
  .practice-invitation h2[tabindex="-1"]:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 4px;
  }

  .practice-invitation__sound-hint {
    font-size: 0.9rem;
    color: var(--stone-text);
    margin-top: var(--space-2);
  }

  .practice-btn {
    display: inline-block;
    margin-top: var(--space-3);
    padding: 0.5rem 1.2rem;
    border-radius: 4px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font: inherit;
    cursor: pointer;
  }

  .practice-btn:hover {
    background: var(--seal);
    border-color: var(--seal);
  }

  .practice-btn:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 3px;
  }

  .practice-btn:disabled {
    opacity: 0.6;
    cursor: default;
  }

  /* --- Timer step --- */
  .practice-step--timer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 0;
  }

  .practice-timer__breath {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--indigo);
    opacity: 0.25;
    animation: pi-breathe 6s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .practice-timer__breath {
      animation: none;
    }
  }

  @keyframes pi-breathe {
    0%, 100% { transform: scale(0.85); opacity: 0.2; }
    50% { transform: scale(1.15); opacity: 0.4; }
  }

  .practice-timer__display {
    font-variant-numeric: tabular-nums;
    font-size: 2.5rem;
    letter-spacing: 0.05em;
    color: var(--ink);
  }

  /* --- Reflection step --- */
  [data-reflection-jump] {
    font-weight: 600;
  }
</style>

<script>
  const DURATION_SECONDS = 180;

  function initPracticeInvitation(root: HTMLElement) {
    const steps: Record<string, HTMLElement | null> = {
      invitation: root.querySelector('[data-step="invitation"]'),
      timer: root.querySelector('[data-step="timer"]'),
      reflection: root.querySelector('[data-step="reflection"]'),
    };
    const display = root.querySelector<HTMLElement>('[data-timer-display]');
    const startBtn = root.querySelector<HTMLButtonElement>('[data-action="start"]');
    const finishBtn = root.querySelector<HTMLButtonElement>('[data-action="finish"]');

    let remaining = DURATION_SECONDS;
    let intervalId: ReturnType<typeof setInterval> | null = null;
    let audioCtx: AudioContext | null = null;
    let finished = false;

    // Reveals a step without hiding steps already shown - the invitation
    // text (why/how to sit) stays visible once the timer starts, and stays
    // visible once the reflection appears too. Per Matan: don't disappear
    // the content that was there before the timer.
    function revealStep(name: string) {
      const el = steps[name];
      if (el) el.hidden = false;
    }

    function formatTime(totalSeconds: number) {
      const m = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
      const s = (totalSeconds % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    function primeAudio() {
      try {
        const Ctx = window.AudioContext || (window as any).webkitAudioContext;
        if (Ctx) {
          audioCtx = new Ctx();
          if (audioCtx.state === 'suspended') audioCtx.resume().catch(() => {});
        }
      } catch {
        audioCtx = null;
      }
    }

    function playEndSound() {
      if (!audioCtx) return;
      try {
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(528, now);
        gain.gain.setValueAtTime(0.0001, now);
        gain.gain.exponentialRampToValueAtTime(0.2, now + 0.05);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 2.2);
        osc.connect(gain).connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 2.3);
      } catch {
        // Silent fail — visual timer + reflection screen remain the fallback.
      }
    }

    function vibrateEnd() {
      try {
        if ('vibrate' in navigator) {
          navigator.vibrate([200, 100, 200]);
        }
      } catch {
        // Unsupported (e.g. iOS Safari) — no-op.
      }
    }

    function finishPractice() {
      if (finished) return; // guard against double-trigger (natural end + late click)
      finished = true;
      if (intervalId !== null) {
        clearInterval(intervalId);
        intervalId = null;
      }
      if (finishBtn) finishBtn.disabled = true;
      playEndSound();
      vibrateEnd();
      revealStep('reflection');
      const heading = root.querySelector<HTMLElement>('[data-reflection-heading]');
      heading?.focus();
    }

    function tick() {
      remaining -= 1;
      if (display) display.textContent = formatTime(Math.max(remaining, 0));
      if (remaining <= 0) finishPractice();
    }

    startBtn?.addEventListener('click', () => {
      primeAudio();
      remaining = DURATION_SECONDS;
      if (display) display.textContent = formatTime(remaining);
      revealStep('timer');
      startBtn.hidden = true; // avoid a second concurrent timer; rest of the invitation text stays visible
      intervalId = setInterval(tick, 1000);
    });

    finishBtn?.addEventListener('click', finishPractice);
  }

  document
    .querySelectorAll<HTMLElement>('[data-practice-invitation]')
    .forEach(initPracticeInvitation);
</script>
