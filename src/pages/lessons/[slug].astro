---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.date.toISOString(),
  inLanguage: "he-IL",
  url: `https://zen.matanbrown.com/lessons/${entry.id}/`,
};
---

<BaseLayout title={entry.data.title} description={entry.data.summary} jsonLd={articleJsonLd}>
  <p class="eyebrow">{entry.data.date.toLocaleDateString("he-IL")}</p>
  <h1>{entry.data.title}</h1>

  {entry.data.videoUrl && (
    <div class="media-embed">
      <video controls src={entry.data.videoUrl}></video>
    </div>
  )}
  {entry.data.audioUrl && !entry.data.videoUrl && (
    <audio controls src={entry.data.audioUrl} class="media-embed"></audio>
  )}

  <div class="prose">
    <Content />
  </div>

  {entry.data.tags && entry.data.tags.length > 0 && (
    <p class="tags">
      {entry.data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </p>
  )}

  <p><a href="/lessons/">← כל השיעורים</a></p>
</BaseLayout>

<style>
  .media-embed { width: 100%; margin-bottom: var(--space-3); border-radius: 4px; }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: var(--space-3); }
  .tag {
    font-size: .78rem;
    color: var(--ink-soft);
    border: 1px solid var(--stone-line);
    border-radius: 999px;
    padding: .15rem .7rem;
  }
</style>
