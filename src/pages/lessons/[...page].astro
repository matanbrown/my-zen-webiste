---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagFilter from "../../components/TagFilter.astro";

export async function getStaticPaths({ paginate }) {
  const lessons = (await getCollection("lessons", ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(lessons, { pageSize: 8 });
}

const { page } = Astro.props;
const allLessons = await getCollection("lessons", ({ data }) => !data.draft);
const allLessonIds = allLessons.map((l) => l.id);
const allTags = [...new Set(allLessons.flatMap((l) => l.data.tags ?? []))].sort();
---

<BaseLayout title="שיעורים" description="שיעורי זן שבועיים">
  <p class="eyebrow">שיעור חדש כל שבוע</p>
  <h1>שיעורים</h1>

  {allLessonIds.length > 1 && (
    <p>
      <a href="#" id="random-lesson-link" data-ids={JSON.stringify(allLessonIds)} data-base="/lessons/">
        🎲 שיעור אקראי
      </a>
    </p>
  )}

  <TagFilter tags={allTags} lang="he" />

  <div id="filterable-list">
    {page.data.map((lesson) => (
      <article class="card" data-tags={(lesson.data.tags ?? []).join(",")}>
        <p class="eyebrow">{lesson.data.date.toLocaleDateString("he-IL")}</p>
        <h2><a href={`/lessons/${lesson.id}/`}>{lesson.data.title}</a></h2>
        {lesson.data.summary && <p>{lesson.data.summary}</p>}
      </article>
    ))}
  </div>

  {page.data.length === 0 && <p>עדיין אין שיעורים כאן — בקרוב.</p>}

  {page.lastPage > 1 && (
    <nav class="pagination" aria-label="עימוד">
      {page.url.prev ? <a href={page.url.prev}>← קודמים</a> : <span />}
      <span class="eyebrow">עמוד {page.currentPage} מתוך {page.lastPage}</span>
      {page.url.next ? <a href={page.url.next}>חדשים יותר →</a> : <span />}
    </nav>
  )}
</BaseLayout>

<script is:inline>
  (function () {
    var link = document.getElementById("random-lesson-link");
    if (!link) return;
    link.addEventListener("click", function (e) {
      e.preventDefault();
      var ids = JSON.parse(link.dataset.ids);
      var pick = ids[Math.floor(Math.random() * ids.length)];
      window.location.href = link.dataset.base + pick + "/";
    });
  })();
</script>

<style>
  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-4);
  }
</style>
