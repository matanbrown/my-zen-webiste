---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const practices = (await getCollection("practices", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="תרגולים" description="תרגולי מדיטציה והליכה בדרך הזן">
  <p class="eyebrow">תרגול, לא תיאוריה</p>
  <h1>תרגולים</h1>

  {practices.map((practice) => (
    <article class="card">
      <div class="row">
        {practice.data.coverImage && (
          <img class="avatar" src={practice.data.coverImage} alt="" loading="lazy" decoding="async" />
        )}
        <div class="row-text">
          <h2><a href={`/practices/${practice.id}/`}>{practice.data.title}</a></h2>
          {practice.data.subtitle && <p>{practice.data.subtitle}</p>}
        </div>
      </div>
    </article>
  ))}

  {practices.length === 0 && <p>עדיין אין תרגולים כאן — בקרוב.</p>}
</BaseLayout>

<style>
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .avatar {
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .row-text h2 {
    margin: 0;
  }
  .row-text p {
    margin: 2px 0 0;
  }
</style>
