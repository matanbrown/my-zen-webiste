---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const items = (await getCollection("inspirationsEn", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Inspirations" description="Poems and works that accompany me on this path" lang="en">
  <p class="eyebrow">Others' works that accompany me</p>
  <h1>Inspirations</h1>

  <ul class="inspiration-list">
    {items.map((item) => (
      <li>
        <h2>
          <a class="row" href={`/en/inspirations/${item.id}/`}>
            {item.data.image && (
              <img class="avatar" src={item.data.image} alt="" loading="lazy" decoding="async" />
            )}
            <span class="row-text">
              <span class="name">{item.data.title}</span>
              {(item.data.author !== item.data.title || item.data.source) && (
                <span class="eyebrow">
                  {item.data.author !== item.data.title && item.data.author}
                  {item.data.source ? ` · ${item.data.source}` : ""}
                </span>
              )}
            </span>
          </a>
        </h2>
      </li>
    ))}
  </ul>

  {items.length === 0 && <p>Nothing here yet — coming soon.</p>}
</BaseLayout>

<style>
  .inspiration-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .inspiration-list li {
    border-bottom: 1px solid var(--stone-line);
  }
  .inspiration-list li:first-child {
    border-top: 1px solid var(--stone-line);
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    text-decoration: none;
    color: inherit;
  }
  .avatar {
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .row-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .name {
    font-size: 1rem;
    font-weight: 500;
  }
  .row:hover .name {
    color: var(--indigo);
  }
</style>
