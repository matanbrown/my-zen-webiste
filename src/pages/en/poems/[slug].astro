---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ShareButtons from "../../../components/ShareButtons.astro";

const FORM_LABELS: Record<string, string> = {
  haiku: "haiku",
  poem: "poem",
  quote: "quote",
};

export async function getStaticPaths() {
  const poems = await getCollection("poemsEn", ({ data }) => !data.draft);
  return poems.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const description = entry.data.author ? `A ${FORM_LABELS[entry.data.form] ?? entry.data.form} by ${entry.data.author}, from "Without Effort"` : `A ${FORM_LABELS[entry.data.form] ?? entry.data.form} from "Without Effort"`;
---

<BaseLayout title={entry.data.title} description={description} image={entry.data.coverImage} lang="en">
  <p class="eyebrow">
    {FORM_LABELS[entry.data.form] ?? entry.data.form}
    {entry.data.author && ` · ${entry.data.author}`}
    {entry.data.translator && ` · translated by ${entry.data.translator}`}
  </p>
  {entry.data.source && <p class="eyebrow">From: {entry.data.source}</p>}

  {entry.data.coverImage && (
    <img class="cover" src={entry.data.coverImage} alt={entry.data.coverImageAlt || entry.data.title} loading="eager" fetchpriority="high" decoding="async" />
  )}

  <div class="poem-body">
    <Content />
  </div>

  {entry.data.externalUrl && (
    <p>
      <a href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer">
        {entry.data.externalLabel ?? "More →"}
      </a>
    </p>
  )}

  <ShareButtons title={entry.data.title} lang="en" />

  <p><a href="/en/poems/">← All poems</a></p>
</BaseLayout>

<style>
  .cover { width: 100%; max-width: var(--measure); border-radius: 4px; margin-block: var(--space-3); }
  .poem-body {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 2;
    margin: var(--space-3) 0 var(--space-4);
  }
  .poem-body :global(p) {
    white-space: pre-line;
  }
</style>
