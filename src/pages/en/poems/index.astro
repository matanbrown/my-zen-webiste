---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const FORM_LABELS: Record<string, string> = {
  haiku: "haiku",
  poem: "poem",
  quote: "quote",
};

const poems = (await getCollection("poemsEn", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Poems" description="Poems and haiku in the spirit of Zen" lang="en">
  <p class="eyebrow">Short words, a lot of space</p>
  <h1>Poems</h1>

  {poems.map((poem) => (
    <article class="card">
      <div class="row">
        {poem.data.coverImage && (
          <img class="avatar" src={poem.data.coverImage} alt="" loading="lazy" decoding="async" />
        )}
        <div class="row-text">
          <p class="eyebrow">{FORM_LABELS[poem.data.form] ?? poem.data.form}{poem.data.author ? ` · ${poem.data.author}` : ""}</p>
          <h2><a href={`/en/poems/${poem.id}/`}>{poem.data.title}</a></h2>
        </div>
      </div>
    </article>
  ))}

  {poems.length === 0 && <p>No poems here yet — coming soon.</p>}
</BaseLayout>

<style>
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .avatar {
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .row-text h2 {
    margin: 0;
  }
  .row-text .eyebrow {
    margin: 0 0 2px;
  }
</style>
