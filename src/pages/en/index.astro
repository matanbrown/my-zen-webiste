---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Enso from "../../components/Enso.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";

const lessons = (await getCollection("lessonsEn", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const inspirations = (await getCollection("inspirationsEn", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestLessons = lessons.slice(0, 3);
const latestInspiration = inspirations[0];
---

<BaseLayout title="Without Effort" description="Weekly lessons, poems, and retreat stories on the Zen path" lang="en">
  <section class="hero">
    <Enso size={140} />
    <h1>Practice, not theory.</h1>
    <p class="eyebrow">A new Zen lesson every week</p>
    <p class="start-here-link"><a href="/en/start-here/">Not sure where to start? Three ways in ←</a></p>
  </section>

  <section class="latest">
    {latestLessons.map((lesson, i) => (
      <div class="latest-item">
        <div class="lesson-row">
          {(lesson.data.avatarImage || lesson.data.coverImage) && (
            <img
              class="avatar"
              src={lesson.data.avatarImage ?? lesson.data.coverImage}
              alt=""
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="lesson-text">
            <p class="eyebrow">{i === 0 ? "Latest lesson" : "Previous lesson"} · {lesson.data.date.toLocaleDateString("en-US")}</p>
            <h2><a href={`/en/lessons/${lesson.id}/`}>{lesson.data.title}</a></h2>
            {lesson.data.summary && <p>{lesson.data.summary}</p>}
          </div>
        </div>
      </div>
    ))}

    {latestInspiration && (
      <div class="latest-item">
        <div class="lesson-row">
          {latestInspiration.data.image && (
            <img
              class="avatar"
              src={latestInspiration.data.image}
              alt=""
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="lesson-text">
            <p class="eyebrow">Latest inspiration</p>
            <h2><a href={`/en/inspirations/${latestInspiration.id}/`}>{latestInspiration.data.title}</a></h2>
            {latestInspiration.data.subtitle && <p>{latestInspiration.data.subtitle}</p>}
          </div>
        </div>
      </div>
    )}

    <p class="more-link"><a href="/en/lessons/">All lessons ←</a></p>
  </section>

  <section class="explore">
    <p class="eyebrow">Elsewhere on the site</p>
    <ul>
      <li><a href="/en/practices/">Practices</a> — the meditation and walking practices I use</li>
      <li><a href="/en/poems/">Poems</a> — short words, a lot of space</li>
      <li><a href="/en/inspirations/">Inspirations</a> — teachers and writers who accompany me</li>
      <li><a href="/en/retreats/">Retreats</a> — personal stories from monasteries and retreats</li>
    </ul>
  </section>

  <NewsletterSignup lang="en" />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-3) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero h1 {
    margin-top: var(--space-2);
    max-width: 16ch;
  }
  .start-here-link {
    margin-top: var(--space-2);
    font-size: 0.9rem;
  }

  .latest {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .latest-item {
    padding-top: var(--space-3);
    border-top: 1px solid var(--stone-line);
  }
  .latest-item .lesson-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .latest-item .avatar {
    inline-size: 56px;
    block-size: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .latest-item .lesson-text {
    min-width: 0;
  }
  .latest-item:first-child {
    padding-top: 0;
    border-top: none;
  }
  .latest-item h2 {
    margin-top: var(--space-1);
  }
  .more-link {
    margin-top: 0;
  }

  .explore {
    margin-top: var(--space-5);
  }
  .explore ul {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .explore a {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
</style>
