---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Enso from "../../components/Enso.astro";

const lessons = (await getCollection("lessonsEn", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const poems = (await getCollection("poemsEn", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestLesson = lessons[0];
const latestPoem = poems[0];
---

<BaseLayout title="Without Effort" description="Weekly lessons, poems, and retreat stories on the Zen path" lang="en">
  <section class="hero">
    <Enso size={140} />
    <h1>Practice, not theory.</h1>
    <p class="eyebrow">A new Zen lesson every week</p>
  </section>

  <hr class="rule" />

  {latestLesson && (
    <article class="card">
      <p class="eyebrow">Latest lesson · {latestLesson.data.date.toLocaleDateString("en-US")}</p>
      <h2><a href={`/en/lessons/${latestLesson.id}/`}>{latestLesson.data.title}</a></h2>
      {latestLesson.data.summary && <p>{latestLesson.data.summary}</p>}
    </article>
  )}

  {latestPoem && (
    <article class="card">
      <p class="eyebrow">Latest poem</p>
      <h2><a href={`/en/poems/${latestPoem.id}/`}>{latestPoem.data.title}</a></h2>
    </article>
  )}

  <p><a href="/en/lessons/">All lessons ←</a></p>

  <hr class="rule" />

  <p class="eyebrow">Elsewhere on the site</p>
  <ul class="explore">
    <li><a href="/en/practices/">Practices</a> — the meditation and walking practices I use</li>
    <li><a href="/en/poems/">Poems</a> — short words, a lot of space</li>
    <li><a href="/en/inspirations/">Inspirations</a> — teachers and writers who accompany me</li>
    <li><a href="/en/retreats/">Retreats</a> — personal stories from monasteries and retreats</li>
  </ul>
</BaseLayout>

<style>
  .hero { padding-block: var(--space-2); }
  .hero h1 { margin-top: var(--space-2); max-width: 16ch; }
  .explore { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .explore a { font-family: var(--font-display); }
</style>
