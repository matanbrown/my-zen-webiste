---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths({ paginate }) {
  const lessons = (await getCollection("lessonsEn", ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(lessons, { pageSize: 8 });
}

const { page } = Astro.props;
const allLessons = await getCollection("lessonsEn", ({ data }) => !data.draft);
const allLessonIds = allLessons.map((l) => l.id);
---

<BaseLayout title="Lessons" description="Weekly Zen lessons" lang="en">
  <p class="eyebrow">A new lesson every week</p>
  <h1>Lessons</h1>

  {allLessonIds.length > 1 && (
    <p>
      <a href="#" id="random-lesson-link" data-ids={JSON.stringify(allLessonIds)} data-base="/en/lessons/">
        🎲 Random lesson
      </a>
    </p>
  )}

  {page.data.map((lesson) => (
    <article class="card">
      <p class="eyebrow">{lesson.data.date.toLocaleDateString("en-US")}</p>
      <h2><a href={`/en/lessons/${lesson.id}/`}>{lesson.data.title}</a></h2>
      {lesson.data.summary && <p>{lesson.data.summary}</p>}
    </article>
  ))}

  {page.data.length === 0 && <p>No lessons here yet — coming soon.</p>}

  {page.lastPage > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {page.url.prev ? <a href={page.url.prev}>← Older</a> : <span />}
      <span class="eyebrow">Page {page.currentPage} of {page.lastPage}</span>
      {page.url.next ? <a href={page.url.next}>Newer →</a> : <span />}
    </nav>
  )}
</BaseLayout>

<script is:inline>
  (function () {
    var link = document.getElementById("random-lesson-link");
    if (!link) return;
    link.addEventListener("click", function (e) {
      e.preventDefault();
      var ids = JSON.parse(link.dataset.ids);
      var pick = ids[Math.floor(Math.random() * ids.length)];
      window.location.href = link.dataset.base + pick + "/";
    });
  })();
</script>

<style>
  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-4);
  }
</style>
