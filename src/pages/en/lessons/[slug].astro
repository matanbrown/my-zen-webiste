---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const lessons = await getCollection("lessonsEn");
  return lessons.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.date.toISOString(),
  inLanguage: "en-US",
  url: `https://zen.matanbrown.com/en/lessons/${entry.id}/`,
};
---

<BaseLayout title={entry.data.title} description={entry.data.summary} jsonLd={articleJsonLd} lang="en">
  <p class="eyebrow">{entry.data.date.toLocaleDateString("en-US")}</p>
  <h1>{entry.data.title}</h1>

  {entry.data.videoUrl && (
    <div class="media-embed">
      <video controls src={entry.data.videoUrl}></video>
    </div>
  )}
  {entry.data.audioUrl && !entry.data.videoUrl && (
    <audio controls src={entry.data.audioUrl} class="media-embed"></audio>
  )}

  <div class="prose">
    <Content />
  </div>

  <p><a href="/en/lessons/">← All lessons</a></p>
</BaseLayout>

<style>
  .media-embed { width: 100%; margin-bottom: var(--space-3); border-radius: 4px; }
</style>
