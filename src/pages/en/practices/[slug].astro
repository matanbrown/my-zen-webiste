---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SaveButton from "../../../components/SaveButton.astro";
import ShareButtons from "../../../components/ShareButtons.astro";

export async function getStaticPaths() {
  const practices = await getCollection("practicesEn", ({ data }) => !data.draft);
  return practices.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const description = entry.data.subtitle ?? `${entry.data.title} — a meditation practice from "Without Effort"`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description,
  inLanguage: "en-US",
  url: `https://zen.matanbrown.com/en/practices/${entry.id}/`,
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Without Effort", item: "https://zen.matanbrown.com/en/" },
    { "@type": "ListItem", position: 2, name: "Practices", item: "https://zen.matanbrown.com/en/practices/" },
    { "@type": "ListItem", position: 3, name: entry.data.title, item: `https://zen.matanbrown.com/en/practices/${entry.id}/` },
  ],
};
---

<BaseLayout title={entry.data.title} description={description} jsonLd={[articleJsonLd, breadcrumbJsonLd]} image={entry.data.coverImage} lang="en">
  <div class="title-row">
    <h1>{entry.data.title}</h1>
    <SaveButton collection="practices" id={entry.id} lang="en" />
  </div>
  {entry.data.subtitle && <p class="eyebrow">{entry.data.subtitle}</p>}
  {entry.data.coverImage && (
    <img class="cover" src={entry.data.coverImage} alt={entry.data.coverImageAlt || entry.data.title} loading="eager" fetchpriority="high" decoding="async" />
  )}
  <div class="prose">
    <Content />
  </div>
  <ShareButtons title={entry.data.title} lang="en" />

  <p><a href="/en/practices/">← All practices</a></p>
</BaseLayout>

<style>
  .cover { width: 100%; border-radius: 4px; margin-block: var(--space-3); }
</style>
