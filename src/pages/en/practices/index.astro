---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const practices = (await getCollection("practicesEn", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Practices" description="Meditation and walking practices on the Zen path" lang="en">
  <p class="eyebrow">Practice, not theory</p>
  <h1>Practices</h1>

  {practices.map((practice) => (
    <article class="card">
      <div class="row">
        {practice.data.coverImage && (
          <img class="avatar" src={practice.data.coverImage} alt="" loading="lazy" decoding="async" />
        )}
        <div class="row-text">
          <h2><a href={`/en/practices/${practice.id}/`}>{practice.data.title}</a></h2>
          {practice.data.subtitle && <p>{practice.data.subtitle}</p>}
        </div>
      </div>
    </article>
  ))}

  {practices.length === 0 && <p>No practices here yet — coming soon.</p>}
</BaseLayout>

<style>
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .avatar {
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .row-text h2 {
    margin: 0;
  }
  .row-text p {
    margin: 2px 0 0;
  }
</style>
