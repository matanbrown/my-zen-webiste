---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Enso from "../components/Enso.astro";

const lessons = (await getCollection("lessons", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const poems = (await getCollection("poems", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestLesson = lessons[0];
const latestPoem = poems[0];
---

<BaseLayout title="ללא מאמץ" description="שיעורים, שירה וסיפורי ריטריט בדרך הזן">
  <section class="hero">
    <Enso size={140} />
    <h1>תרגול, לא תיאוריה.</h1>
    <p class="eyebrow">שיעור זן חדש כל שבוע</p>
  </section>

  <hr class="rule" />

  {latestLesson && (
    <article class="card">
      <p class="eyebrow">השיעור האחרון · {latestLesson.data.date.toLocaleDateString("he-IL")}</p>
      <h2><a href={`/lessons/${latestLesson.id}/`}>{latestLesson.data.title}</a></h2>
      {latestLesson.data.summary && <p>{latestLesson.data.summary}</p>}
    </article>
  )}

  {latestPoem && (
    <article class="card">
      <p class="eyebrow">שירה אחרונה</p>
      <h2><a href={`/poems/${latestPoem.id}/`}>{latestPoem.data.title}</a></h2>
    </article>
  )}

  <p><a href="/lessons/">כל השיעורים ←</a></p>

  <hr class="rule" />

  <p class="eyebrow">עוד באתר</p>
  <ul class="explore">
    <li><a href="/practices/">תרגולים</a> — תרגולי מדיטציה והליכה שאני מתרגל</li>
    <li><a href="/poems/">שירה</a> — מילים קצרות, הרבה מרווח</li>
    <li><a href="/inspirations/">השראה</a> — מורים וכותבים שמלווים אותי</li>
    <li><a href="/retreats/">ריטריטים</a> — סיפורים אישיים ממנזרים וריטריטים</li>
  </ul>
</BaseLayout>

<style>
  .hero { padding-block: var(--space-2); }
  .hero h1 { margin-top: var(--space-2); max-width: 16ch; }
  .explore { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .explore a { font-family: var(--font-display); }
</style>
