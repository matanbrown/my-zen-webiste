---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Enso from "../components/Enso.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";

const lessons = (await getCollection("lessons", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const inspirations = (await getCollection("inspirations", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestLesson = lessons[0];
const latestInspiration = inspirations[0];
---

<BaseLayout title="ללא מאמץ" description="שיעורים, שירה וסיפורי ריטריט בדרך הזן">
  <section class="hero">
    <Enso size={140} />
    <h1>תרגול, לא תיאוריה.</h1>
    <p class="eyebrow">שיעור זן חדש כל שבוע</p>
    <p class="start-here-link"><a href="/start-here/">לא בטוחים מאיפה להתחיל? שלוש דרכים להיכנס ←</a></p>
  </section>

  <section class="latest">
    {latestLesson && (
      <div class="latest-item">
        <div class="lesson-row">
          {(latestLesson.data.avatarImage || latestLesson.data.coverImage) && (
            <img
              class="avatar"
              src={latestLesson.data.avatarImage ?? latestLesson.data.coverImage}
              alt=""
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="lesson-text">
            <p class="eyebrow">השיעור האחרון · {latestLesson.data.date.toLocaleDateString("he-IL")}</p>
            <h2><a href={`/lessons/${latestLesson.id}/`}>{latestLesson.data.title}</a></h2>
            {latestLesson.data.summary && <p>{latestLesson.data.summary}</p>}
          </div>
        </div>
      </div>
    )}

    {latestInspiration && (
      <div class="latest-item">
        <div class="lesson-row">
          {latestInspiration.data.image && (
            <img
              class="avatar"
              src={latestInspiration.data.image}
              alt=""
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="lesson-text">
            <p class="eyebrow">השראה אחרונה</p>
            <h2><a href={`/inspirations/${latestInspiration.id}/`}>{latestInspiration.data.title}</a></h2>
            {latestInspiration.data.subtitle && <p>{latestInspiration.data.subtitle}</p>}
          </div>
        </div>
      </div>
    )}

    <p class="more-link"><a href="/lessons/">כל השיעורים ←</a></p>
  </section>

  <section class="explore">
    <p class="eyebrow">עוד באתר</p>
    <ul>
      <li><a href="/practices/">תרגולים</a> — תרגולי מדיטציה והליכה שאני מתרגל</li>
      <li><a href="/poems/">שירה</a> — מילים קצרות, הרבה מרווח</li>
      <li><a href="/inspirations/">השראה</a> — מורים וכותבים שמלווים אותי</li>
      <li><a href="/retreats/">ריטריטים</a> — סיפורים אישיים ממנזרים וריטריטים</li>
    </ul>
  </section>

  <NewsletterSignup lang="he" />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-3) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero h1 {
    margin-top: var(--space-2);
    max-width: 16ch;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2rem);
  }
  .start-here-link {
    margin-top: var(--space-2);
    font-size: 0.9rem;
  }

  .latest {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .latest-item {
    padding-top: var(--space-3);
    border-top: 1px solid var(--stone-line);
  }
  .latest-item .lesson-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .latest-item .avatar {
    inline-size: 56px;
    block-size: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .latest-item .lesson-text {
    min-width: 0;
  }
  .latest-item:first-child {
    padding-top: 0;
    border-top: none;
  }
  .latest-item h2 {
    margin-top: var(--space-1);
  }
  .more-link {
    margin-top: 0;
  }

  .explore {
    margin-top: var(--space-5);
  }
  .explore ul {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .explore a {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
</style>
