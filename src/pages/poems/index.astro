---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const FORM_LABELS: Record<string, string> = {
  haiku: "הייקו",
  poem: "שיר",
  quote: "ציטוט",
};

const poems = (await getCollection("poems", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="שירה" description="שירה והייקו בהשראת זן">
  <p class="eyebrow">מילים קצרות, הרבה מרווח</p>
  <h1>שירה</h1>

  {poems.map((poem) => (
    <article class="card">
      <div class="row">
        {poem.data.coverImage && (
          <img class="avatar" src={poem.data.coverImage} alt="" loading="lazy" decoding="async" />
        )}
        <div class="row-text">
          <p class="eyebrow">{FORM_LABELS[poem.data.form] ?? poem.data.form}{poem.data.author ? ` · ${poem.data.author}` : ""}</p>
          <h2><a href={`/poems/${poem.id}/`}>{poem.data.title}</a></h2>
        </div>
      </div>
    </article>
  ))}

  {poems.length === 0 && <p>עדיין אין שירים כאן — בקרוב.</p>}
</BaseLayout>

<style>
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .avatar {
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .row-text h2 {
    margin: 0;
  }
  .row-text .eyebrow {
    margin: 0 0 2px;
  }
</style>
