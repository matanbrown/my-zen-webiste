---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const retreats = (await getCollection("retreats", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="ריטריטים" description="סיפורים ממנזרים וריטריטים">
  <p class="eyebrow">מסע פנימי, מקום אחר</p>
  <h1>ריטריטים</h1>

  {retreats.map((retreat) => (
    <article class="card">
      <p class="eyebrow">{retreat.data.place}{retreat.data.year ? ` · ${retreat.data.year}` : ""}</p>
      <h2><a href={`/retreats/${retreat.id}/`}>{retreat.data.title}</a></h2>
    </article>
  ))}

  {retreats.length === 0 && <p>עדיין אין סיפורים כאן — בקרוב.</p>}
</BaseLayout>
