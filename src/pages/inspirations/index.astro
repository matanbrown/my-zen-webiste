---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const items = (await getCollection("inspirations", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="השראה" description="שירה ויצירות שמלוות אותי בדרך">
  <p class="eyebrow">יצירות של אחרים שמלוות אותי</p>
  <h1>השראה</h1>

  {items.map((item) => (
    <article class="card">
      {item.data.image && (
        <img class="thumb" src={item.data.image} alt={item.data.imageAlt ?? item.data.title} loading="lazy" decoding="async" />
      )}
      {(item.data.author !== item.data.title || item.data.source) && (
        <p class="eyebrow">
          {item.data.author !== item.data.title && item.data.author}
          {item.data.source ? ` · ${item.data.source}` : ""}
        </p>
      )}
      <h2><a href={`/inspirations/${item.id}/`}>{item.data.title}</a></h2>
    </article>
  ))}

  {items.length === 0 && <p>עדיין אין כאן כלום — בקרוב.</p>}
</BaseLayout>

<style>
  .card {
    display: flow-root;
  }
  .thumb {
    float: inline-end;
    inline-size: 25%;
    max-inline-size: 96px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
    margin-inline-start: var(--space-2);
  }
</style>
