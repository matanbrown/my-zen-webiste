---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="הדף לא נמצא" description="הדף שחיפשת לא קיים">
  <div id="404-he">
    <p class="eyebrow">404</p>
    <h1>הדף הזה עדיין ריק.</h1>
    <p>הדף שחיפשת לא קיים, או שהוא זז למקום אחר.</p>
    <p><a href="/">← חזרה לדף הבית</a></p>
  </div>
  <div id="404-en" dir="ltr" hidden>
    <p class="eyebrow">404</p>
    <h1>This page is still empty.</h1>
    <p>The page you were looking for doesn't exist, or moved somewhere else.</p>
    <p><a href="/en/">← Back to homepage</a></p>
  </div>
</BaseLayout>

<script is:inline>
  // Cloudflare Pages only serves one static 404.html for the whole site
  // regardless of path prefix — but the browser's address bar still shows
  // the real URL the visitor requested, so we can detect /en/ client-side
  // and swap in the English version instead of always showing Hebrew.
  (function () {
    if (location.pathname === "/en" || location.pathname.startsWith("/en/")) {
      document.documentElement.lang = "en";
      document.documentElement.dir = "ltr";
      var he = document.getElementById("404-he");
      var en = document.getElementById("404-en");
      if (he) he.hidden = true;
      if (en) en.hidden = false;
    }
  })();
</script>
