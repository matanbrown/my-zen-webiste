---
import BaseLayout from "../../layouts/BaseLayout.astro";

const TURNSTILE_SITE_KEY = "0x4AAAAAAD_AbQsAare0umvG";
---

<BaseLayout title="הסרה מרשימת התפוצה" description="הסרה מרשימת התפוצה">
  <p class="eyebrow">רשימת תפוצה</p>
  <h1>הסרה מרשימת התפוצה</h1>
  <p>לא תקבל/י יותר מיילים על שיעורים חדשים באתר.</p>

  <form id="unsub-form" novalidate>
    <input
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="האימייל שלך"
      aria-label="כתובת אימייל"
    />
    <div id="turnstile-wrap" class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} hidden></div>
    <button type="submit">הסר/י אותי</button>
  </form>
  <p id="unsub-status" role="status" class="eyebrow"></p>

  <p><a href="/">← חזרה לדף הבית</a></p>
</BaseLayout>

<script async src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
<script type="module">
  const form = document.getElementById("unsub-form");
  const status = document.getElementById("unsub-status");
  const turnstileWrap = document.getElementById("turnstile-wrap");
  const params = new URLSearchParams(location.search);
  const prefillEmail = params.get("email");
  const token = params.get("token");
  if (prefillEmail) form.email.value = prefillEmail;

  // A signed token proves this link came from an actual email we sent —
  // no need for a CAPTCHA in that case. Only show Turnstile when someone
  // is unsubscribing "by hand" without a token.
  if (!token) {
    turnstileWrap.hidden = false;
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submitButton = form.querySelector("button[type=submit]");
    submitButton.disabled = true;
    status.textContent = "מסיר/ה…";

    const payload = { email: form.email.value };
    if (token) {
      payload.token = token;
    } else {
      payload.turnstileToken = new FormData(form).get("cf-turnstile-response");
    }

    try {
      const res = await fetch("/api/unsubscribe", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await res.json();
      if (result.ok) {
        status.textContent = "הוסר/ה בהצלחה. לא תקבל/י יותר מיילים מהאתר.";
        form.hidden = true;
      } else {
        status.textContent = "משהו נכשל. אפשר לנסות שוב מאוחר יותר.";
        submitButton.disabled = false;
      }
    } catch {
      status.textContent = "משהו נכשל. אפשר לנסות שוב מאוחר יותר.";
      submitButton.disabled = false;
    }
  });
</script>

<style>
  #unsub-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-top: var(--space-2);
    max-width: 28rem;
  }
  #unsub-form input {
    flex: 1 1 14rem;
    font: inherit;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--stone-line);
    border-radius: 4px;
    background: var(--paper-raised);
    color: var(--ink);
  }
  #unsub-form input:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 1px;
  }
  #unsub-form button {
    padding: 0.5rem 1.2rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    border-radius: 4px;
    font: inherit;
    cursor: pointer;
  }
  #unsub-form button:hover {
    background: var(--seal);
    border-color: var(--seal);
  }
  #unsub-form button:disabled {
    opacity: 0.6;
    cursor: default;
  }
  #unsub-status {
    min-height: 1.2em;
    margin-top: var(--space-2);
  }
</style>
